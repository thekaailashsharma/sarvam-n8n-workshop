    {
      "parameters": {
        "text": "={{ $('Sarvam: Transcribe').item.json.transcript }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action_items\": {\n      \"type\": \"array\",\n      \"description\": \"Every concrete action item, decision or follow-up mentioned. One entry each.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\",\n            \"description\": \"Imperative, max 80 chars, e.g. 'Fix checkout crash on Android UPI'\"\n          },\n          \"problem\": {\n            \"type\": \"string\",\n            \"description\": \"One line: what is broken, missing or needed, as stated in the meeting\"\n          },\n          \"expected\": {\n            \"type\": \"string\",\n            \"description\": \"One line: what 'done' looks like / the expected behaviour or outcome\"\n          },\n          \"impact\": {\n            \"type\": \"string\",\n            \"description\": \"One line: who is affected and why it matters (release, customers, revenue). Empty if not stated\"\n          },\n          \"acceptance_criteria\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"2-3 short, testable checks that would close this item. Infer sensibly from the problem; do not invent facts\"\n          },\n          \"owner\": {\n            \"type\": \"string\",\n            \"description\": \"Person named as responsible, else empty string\"\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"P1\",\n              \"P2\",\n              \"P3\",\n              \"P4\"\n            ],\n            \"description\": \"P1 blocker/outage, P2 urgent, P3 normal, P4 nice-to-have\"\n          },\n          \"due\": {\n            \"type\": \"string\",\n            \"description\": \"Deadline as spoken, e.g. 'Wednesday', 'before launch', else empty\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"problem\",\n          \"expected\",\n          \"impact\",\n          \"acceptance_criteria\",\n          \"owner\",\n          \"priority\",\n          \"due\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"action_items\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You are a senior product manager writing tickets from a meeting transcript. Extract every action item, decision and follow-up. Write like a PM: crisp one-liners, concrete expected outcome, testable acceptance criteria. Never invent names, dates or numbers that were not said. {format_instructions}"
        }
      },
      "id": "e29c73f8-ca8b-468e-835a-57cf0ec28ce7",
      "name": "Extract Action Items",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1500,
        300
      ]
