      "typeVersion": 2.1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "text": "={{ $('Sarvam: Transcribe').item.json.transcript }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action_items\": {\n      \"type\": \"array\",\n      \"description\": \"Every concrete action item, decision or follow-up mentioned. One entry each.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\",\n            \"description\": \"Imperative, max 80 chars, e.g. 'Fix checkout crash on Android UPI'\"\n          },\n          \"detail\": {\n            \"type\": \"string\",\n            \"description\": \"1-2 sentences of context from the transcript\"\n          },\n          \"owner\": {\n            \"type\": \"string\",\n            \"description\": \"Person named as responsible, else empty string\"\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"P1\",\n              \"P2\",\n              \"P3\",\n              \"P4\"\n            ],\n            \"description\": \"P1 blocker/outage, P2 urgent, P3 normal, P4 nice-to-have\"\n          },\n          \"due\": {\n            \"type\": \"string\",\n            \"description\": \"Deadline as spoken, e.g. 'Wednesday', 'before launch', else empty\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"detail\",\n          \"owner\",\n          \"priority\",\n          \"due\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"action_items\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You are an expert meeting scribe. Extract every action item, decision and follow-up from the transcript. Never invent names or dates. {format_instructions}"
        }
      },
      "id": "157f5bd6-2aa6-43ee-8f30-b66e32e6c4cb",
      "name": "Extract Action Items",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "output.action_items",
        "include": "noOtherFields",
        "options": {}
      },
      "id": "8ee5e924-1f4d-460e-8023-98dee1b1eec6",
      "name": "One Item per Action",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "inputText": "={{ $json.title }} — {{ $json.detail }}",
        "categories": {
          "categories": [
            {
              "category": "bug",
              "description": "Something is broken, crashing, failing or behaving wrongly. Needs a fix."
            },
            {
              "category": "feature",
              "description": "New capability, enhancement or design work that a user would notice."
            },
            {
              "category": "task",
              "description": "Engineering or ops chore: config, setup, migration, runbook, documentation."
            },
            {
              "category": "decision",
              "description": "A decision that was made and must be recorded, not work to do."
            },
            {
              "category": "followup",
              "description": "A reminder to chase, ask, check or get back to someone."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Classify the meeting action item into exactly one category.\n{categories}\n\nJust the category label."
        }
      },
